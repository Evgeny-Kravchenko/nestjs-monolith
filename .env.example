# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Registration
REGISTRATION_VERIFICATION_ENABLED=false
REGISTRATION_VERIFICATION_METHOD=otp
REGISTRATION_SECRET_KEY=change-me-to-at-least-32-random-characters
REGISTRATION_MAGIC_LINK_BASE_URL=http://localhost:4200/register/confirm
REGISTRATION_THROTTLE_TTL=60000
REGISTRATION_THROTTLE_LIMIT=5

# Mail (SMTP) - local Mailpit; use SMTP_HOST=mailpit when the backend runs in docker compose
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost
